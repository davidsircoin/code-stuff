module Day3 where

import Parsing as  P
import Data.Maybe
day3 :: IO ()
day3 = do
    myfile <- readFile "./inputs/input3.txt"
    print myfile

parMulstring =  P.string "mul"


par3Dig = P.count 3 digit <|> P.count 2 digit <|> P.count 1 digit


scan :: String -> Maybe String
scan xs = map (filter isNothing) (fst . head parsedxs)
            where parsedxs = parse (many  (fmap (\x -> Just x) parseMulOp <|> fmap (\x -> Nothing) ignore)) xs


parseMulOp = do mul <- parMulstring 
                _ <- char '('
                dig1 <- par3Dig
                _ <- char ','
                dig2 <- par3Dig
                _ <- char ')'
                return $  "mul(" ++ dig1 ++ "," ++  dig2 ++ ")"

