cabal-version:   3.0
name:            advent-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
author:          david
maintainer:      davidsircoin@proton.me
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -w

executable advent-hs
    import:           warnings
    main-is:          Main.hs
    exposed-modules:  Parsing
                      Matrices
    other-modules:    Day1
                      Day2
                      Day3
                      Day4
                    

    build-depends:    base ^>=4.17.2.1,
                      containers >=0.6.7,
                      megaparsec >=9.0
    hs-source-dirs:   app
    default-language: Haskell2010
